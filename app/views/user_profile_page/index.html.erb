<% if @show_profile_incomplete_modal %>
<!-- Modal code as provided above -->
<div
  id="incompleteProfileModal"
  class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50"
>
  <!-- Modal Content -->
  <div class="bg-white rounded-lg shadow-lg p-6 max-w-md w-full">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-lg font-semibold text-gray-900">Complete o Seu Perfil</h2>
      <button
        type="button"
        onclick="closeModal()"
        class="text-gray-500 hover:text-gray-700 focus:outline-none"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"
          />
        </svg>
      </button>
    </div>
    <div class="mb-4 text-gray-700">
      <p>
        Seu perfil só tem <%= @user&.profile_completion_percentage %>% completo.
        Por favor clique no botão abaixo para o completar.
      </p>
    </div>
    <div class="flex justify-start space-x-2">
      <%= link_to 'Completar Perfil', new_profile_path,
      class:'bg-freelancers-dark-blue text-freelancers-white-background p-3
      rounded-lg' %>
    </div>
  </div>
</div>

<script>
  // Automatically show the modal if the profile is incomplete
  document.addEventListener('DOMContentLoaded', function () {
    document
      .getElementById('incompleteProfileModal')
      .classList.remove('hidden');
  });

  // Function to close the modal
  function closeModal() {
    document.getElementById('incompleteProfileModal').classList.add('hidden');
  }
</script>
<% end %>

<div class="container mx-auto p-4 max-w-4xl">
  <div class="b shadow-md rounded-lg overflow-hidden">
    <div
      class="bg-freelancers-dark-blue text-freelancers-white-background p-6 flex items-center space-x-4"
    >
      <%= image_tag user_profile_image_or_generic_image(@user), class:"w-32 h-32
      rounded-full border-4 border-freelancers-white-background",
      alt:"#{@user&.first_name} #{@user&.last_name}" %>

      <div>
        <h1 class="text-3xl font-bold"><%= user_name %></h1>

        <p class="text-xl text-freelancers-light-orange">
          <%= @user&.profile&.current_position || 'Sua posição actual' %>
        </p>
        <p class="text-lg">
          <%= @user&.profile&.academic_title || 'Título acadêmico' %>
        </p>
      </div>
      <div>
        <%= "is profile incomplete = #{@show_profile_incomplete_modal} " %> <%=
        link_to 'logout', destroy_user_session_path,
        data:{turbo_method:'delete'} %> <%= link_to 'Completar Perfil',
        new_profile_path, class:'bg-freelancers-dark-blue
        text-freelancers-white-background p-3 rounded-lg' %>
      </div>
      <div>
        <%= link_to 'editar perfil básico', edit_user_registration_path %>
      </div>
    </div>
    <div class="p-6">
      <section class="mb-6">
        <h2
          class="text-2xl font-bold text-freelancers-paragraph border-b-2 border-primary pb-2 mb-4"
        >
          Informações Pessoais
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-secondary">
          <div>
            <span class="font-bold text-freelancers-paragraph"
              >Nacionalidade:</span
            >

            <p class="text-freelancers-text-gray"><%= @user&.nationality %></p>
          </div>
          <div>
            <span class="font-bold text-freelancers-paragraph"
              >Data de Nascimento:</span
            >
            <p class="text-freelancers-text-gray"><%= @user&.date_of_birth %></p>
          </div>
          <div>
            <span class="font-bold text-freelancers-paragraph">
              Years of Experience:</span
            >
            <p class="text-freelancers-text-gray">
              <%= @user&.profile&.years_of_experience || 'Seus anos de
              experiência' %>
            </p>
          </div>
        </div>
      </section>

      <section class="mb-6">
        <h2
          class="text-2xl font-bold text-freelancers-paragraph border-b-2 border-primary pb-2 mb-4"
        >
          Informações de Contacto
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-secondary">
          <div>
            <span class="font-bold text-freelancers-paragraph">Email:</span>
            <p class="text-freelancers-text-gray"><%= @user&.email %></p>
          </div>
          <div>
            <span class="font-bold text-freelancers-paragraph">Telemóvel:</span>
            <p class="text-freelancers-text-gray"><%= @user&.cellphone %></p>
          </div>
          <div>
            <span class="font-bold text-freelancers-paragraph">Endereço:</span>
            <p class="text-freelancers-text-gray">
              <%= @user&.profile&.street || 'Seu Endereço Actual' %>
            </p>
          </div>
          <div>
            <span class="font-bold text-freelancers-paragraph">LinkedIn:</span>
            <% if @user&.profile&.linked_In_link %> 
                <%= link_to "#{@user&.first_name} linkedIn", @user&.profile&.linked_In_link, class:"text-primary hover:underline text-freelancers-mid-blue" %> 
            <% end %>
          </div>
        </div>
      </section>

      <section class="mb-6">
        <h2
          class="text-2xl font-bold text-primary border-b-2 border-primary pb-2 mb-4 text-freelancers-paragraph"
        >
          Resumo Profissional
        </h2>
        <p class="text-secondary text-freelancers-text-gray">
          <%= @user&.profile&.professional_resume || "" %>
        </p>
      </section>

      <section class="mb-6">
        <h2
          class="text-2xl font-bold text-primary border-b-2 border-primary pb-2 mb-4 text-freelancers-paragraph"
        >
          Áreas de Interesse
        </h2>
        <div class="flex flex-wrap gap-2">
          <% if @user&.profile&.areas_of_interest&.empty? %>
            <p>Adicione algumas áreas do seu interesse</p>
          <% else %>
            <% @user&.profile&.areas_of_interest&.each do |area_of_interest| %>
              <span class="bg-primary text-freelancers-text-gray px-3 py-1 rounded-full text-sm">
                <%= area_of_interest&.name %>
              </span>
            <% end %>
        <% end %>
        
        </div>
      </section>

      <section class="mb-6">
        <h2
          class="text-2xl font-bold text-primary border-b-2 border-primary pb-2 mb-4 text-freelancers-paragraph"
        >
          Idiomas
        </h2>
        <div class="flex flex-wrap gap-2">
          <% if @user&.profile&.idioms&.empty? %>
            <p>Adicione os idiomas que tem conhecimento</p>
          <%else %>
            <% @user&.profile&.idioms&.each do |idiom| %>

          <span
            class="bg-primary text-freelancers-text-gray px-3 py-1 rounded-full text-sm"
            ><%= idiom&.name %></span
          >
            <% end %>
          <% end %>
        
        </div>
      </section>

      <section class="mb-6">
        <h2
          class="text-2xl font-bold text-primary border-b-2 border-primary pb-2 mb-4"
        >
          Cursos
        </h2>
        <ul class="space-y-4">
          <li class="bg-gray-100 p-3 rounded-lg border-l-4 border-accent">
            <div class="font-bold text-primary">Advanced Machine Learning</div>
            <div class="text-sm text-secondary">Stanford University
