            <p class="text-freelancers-text-gray">+1 (555) 123-4567</p>
          </div>
          <div>
            <span class="font-bold text-freelancers-paragraph">Endereço:</span>
            <p class="text-freelancers-text-gray">
              123 Tech Street, San Francisco, CA 94122, USA
            </p>
          </div>
          <div>
            <span class="font-bold text-freelancers-paragraph">LinkedIn:</span>
            <a
              href="https://www.linkedin.com/in/johndoe"
              class="text-primary hover:underline text-freelancers-mid-blue"
