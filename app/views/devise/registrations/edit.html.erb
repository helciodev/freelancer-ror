


<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <%= f.label :email %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
  </div>
  <div class="field">
    <%= f.label :email %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
  </div>
  <div class="field">
    <%= f.label :email %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
  </div>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <div>Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
  <% end %>

  <div class="field">
    <%= f.label :first_name, 'Primeiro Nome' %>
    <%= f.text_field :first_name, autofocus: true,
    class:'border border-red-500' %>
  </div>
  
  <div class="field">
    <%= f.label :last_name, 'Sobrenome' %>
    <%= f.text_field :last_name, autofocus: true,
    class:'border border-red-500' %>
  </div>
  
  <div class="field">
    <%= f.label :email %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email",
    class:'border border-red-500' %>
  </div>
  
  <div class="field">
    <%= f.label :cellphone, 'Telemóvel' %>
    <%= f.telephone_field :cellphone, autofocus: true, autocomplete: "email",
    class:'border border-red-500' %>
  </div>

  <div class="field">
    <%= f.label :gender, 'Gênero' %>
    <%= f.select :gender, options_for_select([['Masculino', 'masculino'], ['Feminino', 'feminino'], ['Outro', 'outro']]), prompt: 'Selecione gênero', class:'border border-red-500' %>
    
  </div>
  <div class="field">
    <%= f.label :profile_pic, 'Foto de Perfil' %>
    <%= f.file_field :profile_pic, class:'border border-red-500' %>
    
  </div>
  
  <div class="field">
    <%= f.label :date_of_birth, 'Data de nascimento' %>
    <%= f.datetime_field :date_of_birth, class:'border border-red-500 birth-date' %>
  </div>

  <div class="field">
    <%= f.label :nationality %>
    <%= f.select :nationality, options_for_select([
      ['Angolano', 'AO'],
      ['Brasileiro', 'BR'],
      ['Português', 'PT']
    ], resource.nationality), prompt: 'Selecione Nacionalidade', class: 'border border-red-500' %>
  </div>
  
  <div class="field">
    <%= f.label :password, 'Palavra Passe' %> <% if @minimum_password_length %>
    <em>(<%= @minimum_password_length %> caracteres no mínimo)</em>
    <% end %>
    <%= f.password_field :password, autocomplete: "new-password", class:'border
    border-red-500' %>
  </div>
  
  <div class="field">
    <%= f.label :password_confirmation %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password",
    class:'border border-red-500' %>
  </div>

  <div class="actions">
    <%= f.submit "Update" %>
  </div>
<% end %>

<h3>Cancel my account</h3>

<div>Unhappy? <%= button_to "Cancel my account", registration_path(resource_name), data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, method: :delete %></div>

<%= link_to "Back", :back %>
