<section class="grid grid-cols-3 border bg-gray-200 max-md:grid-cols-1">
    <div class="col-span-2 p-8">
      <%= image_tag "/assets/profile-banner.png", alt: "Profile banner", class: "w-full" %>
    </div>
    <div class="bg-white">
      <div class="mx-12 mt-10 flex flex-col items-center justify-center">
        <h2 class="text-xl font-bold text-freelancers-dark-text">Criar Novo Perfil</h2>
        
        <%= form_for @profile, url: profiles_path, html: { multipart: true }, method: :post do |f| %>
          <div class="field mb-4">
            <%= f.label :current_position, "Cargo Atual" %>
            <%= f.text_field :current_position, class: "border border-gray-300 w-full p-2" %>
          </div>
  
          <div class="field mb-4">
            <%= f.label :academic_title, "Título Acadêmico" %>
            <%= f.text_field :academic_title, class: "border border-gray-300 w-full p-2" %>
          </div>

          <div class="field mb-4">
            <%= f.label :years_of_experience, "Anos de Experiência" %>
            <%= f.number_field :years_of_experience, class: "border border-gray-300 w-full p-2" %>
          </div>
  
          <div class="field mb-4">
            <%= f.label :link_to_resume, "Link para o Currículo" %>
            <%= f.url_field :link_to_resume, class: "border border-gray-300 w-full p-2" %>
          </div>
  
          <div class="field mb-4">
            <%= f.label :idioms, "Idiomas" %>
            <div class="flex flex-col space-y-2">
              <% ["espanhol", "ingles", "português", "francês"].each do |language| %>
                <label>
                  <%= check_box_tag "profile[idioms][]", language, @profile.idiomas&.include?(language) %> 
                  <%= language.capitalize %>
                </label>
              <% end %>
            </div>
          </div>
          
          <div class="field mb-4">
            <%= f.label :areas_of_interest, "Áreas de Interesse" %>
            <div class="flex flex-col space-y-2">
              <% AreaOfInterest.all.each do |area| %>
                <label>
                  <%= check_box_tag "profile[areas_of_interest][]", area.name, @profile.areas_of_interest&.include?(area.name) %> 
                  <%= area.name %>
                </label>
              <% end %>
            </div>
          </div>
          </div>
  
          <div class="field mb-4">
            <%= f.label :profile_picture, "Foto de Perfil" %>
            <%= f.file_field :profile_picture, class: "border border-gray-300 w-full p-2" %>
          </div>
  
          <div class="actions text-center mt-8">
            <%= f.submit "Criar Perfil", class: "bg-freelancers-light-blue text-white px-4 py-2 rounded" %>
          </div>
        <% end %>
      </div>
    </div>
  </section>