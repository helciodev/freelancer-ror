<section class="grid grid-cols-3 border bg-gray-200 max-md:grid-cols-1">
    <div class="col-span-2 p-8 flex items-center ">
      <%= image_tag "humans-ilustrations/Humaaans-standing.svg", alt: "Profile banner",   class:'w-[560px] h-[430px]' %>
    </div>
    <div class="bg-white">
      <div class="mx-12 mt-10 flex flex-col items-center justify-center">
        <h2 class="text-xl font-bold text-freelancers-dark-text">Criar Novo Perfil</h2>
        
        <%= form_with(model: @profile, html:{class:"bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4 w-full max-w-md"}) do |f|  %>
          <div class="field mb-4">
            <%= f.label :current_position, "Cargo Atual" %>
            <%= f.text_field :current_position, class: "border border-gray-300 w-full p-2", placeholder:'advogado'%>
          </div>
  
          <div class="field mb-4">
            <%= f.label :academic_title, "Título Acadêmico" %>
            <%= f.text_field :academic_title, class: "border border-gray-300 w-full p-2", placeholder:'Bacharel' %>
          </div>

          <div class="field mb-4">
            <%= f.label :years_of_experience, "Anos de Experiência" %>
            <%= f.number_field :years_of_experience, class: "border border-gray-300 w-full p-2", placeholder:'3' %>
          </div>
  
          <div class="field mb-4">
            <%= f.label :link_to_resume, "Link para o Currículo" %>
            <%= f.url_field :link_to_resume, class: "border border-gray-300 w-full p-2" %>
          </div>
  
          <div class="field mb-4">
            <%= f.label :professional_resume, "Resumo profissional" %>
            <%= f.text_area :professional_resume, class: "border border-gray-300 w-full p-2", placeholder:'', rows:5  %>
          </div>

          <div class="field mb-4">
            <%= f.label :municipy, "Município" %>
            <%= f.text_field :municipy, class: "border border-gray-300 w-full p-2", placeholder:'Belas' %>
          </div>

          <div class="field mb-4">
            <%= f.label :province, "Província" %>
            <%= f.text_field :province, class: "border border-gray-300 w-full p-2", placeholder:'Luanda' %>
          </div>

          <div class="field mb-4">
            <%= f.label :street, "Endereço" %>
            <%= f.text_field :street, class: "border border-gray-300 w-full p-2", placeholder:'Rua, número, complemento' %>
          </div>

          <div class="field mb-4">
            <%= f.label :idioms, "Idiomas" %>
            <div class="flex items-center space-x-3 bg-gray-100 p-1 rounded-lg hover:bg-gray-200 transition-colors duration-200 flex-wrap">
              <% ["espanhol", "ingles", "português", "francês"].each do |language| %>
                <label>
                  <%= check_box_tag "profile[idioms][]", language, @profile.idioms&.include?(language) %> 
                  <%= language.capitalize %>
                </label>
              <% end %>
            </div>
          </div>
          
          <div class="field mb-4">
           <label for="">
            Areas de Interesse
           </label>
            <div class=" flex items-center space-x-3 bg-gray-100 p-1 rounded-lg hover:bg-gray-200 transition-colors duration-200 flex-wrap">
              <%= f.collection_check_boxes :areas_of_interest_ids, AreaOfInterest.all, :id, :name %>

            </div>
          </div>
          </div>
  
        
  
          <div class="actions text-center mt-8">
            <%= f.submit "Adicionar Dados", class: "bg-freelancers-light-blue text-white px-4 py-2 rounded cursor-pointer" %>
          </div>
        <% end %>
      </div>
    </div>
  </section>